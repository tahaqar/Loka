datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String        @id @default(cuid())
  name            String
  email           String        @unique
  passwordHash    String
  phone           String?
  roleId          String
  role            Role          @relation(fields: [roleId], references: [id])
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive        Boolean       @default(true)
  lastLoginAt     DateTime?
  avatar          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  assignedStudents      Student[]              @relation("StudentCounselor")
  assignedApplications  Application[]          @relation("ApplicationOfficer")
  assignedTasks         Task[]                 @relation("TaskAssignee")
  createdTasks          Task[]                 @relation("TaskCreator")
  assignedVisaCases     VisaCase[]             @relation("VisaOfficer")
  receivedPayments      Payment[]              @relation("PaymentReceiver")
  communications        Communication[]        @relation("UserCommunications")
  auditLogs             AuditLog[]             @relation("UserAuditLogs")
  notifications         Notification[]

  @@index([email])
  @@index([roleId])
  @@index([branchId])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  displayName String
  description String?
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  action      String           // view, create, edit, delete, export
  module      String           // students, applications, documents, visa, payments, commissions, reports, users, settings
  name        String           @unique // e.g. students:view
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  roles       RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Branch {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  city        String
  country     String
  address     String?
  phone       String?
  email       String?
  isHeadquarter Boolean  @default(false)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  users       User[]
  students    Student[]

  @@index([code])
}

model Country {
  id                 String       @id @default(cuid())
  code               String       @unique // e.g. ES, MT, DE
  nameAr             String
  nameEn             String
  flagEmoji          String
  currencyCode       String?
  visaRequirements   String?
  admissionRequirements String?
  languageRequirements  String?
  checklistNotes     String?
  responsibleStaff   String?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?

  universities       University[]
  checklistTemplates CountryChecklistTemplate[]
  applications       Application[]
  visaCases          VisaCase[]

  @@index([code])
}

model University {
  id                 String       @id @default(cuid())
  nameAr             String
  nameEn             String
  countryId          String
  country            Country      @relation(fields: [countryId], references: [id])
  city               String
  type               String       @default("university") // university, institute
  website            String?
  contactPerson      String?
  contactEmail       String?
  contactPhone       String?
  responsibleStaff   String?
  generalRequirements String?
  deadlinesSummary   String?
  commissionType     String       @default("percentage") // percentage, fixed
  commissionValue    Float        @default(15.0)
  commissionCurrency String       @default("EUR")
  contractStatus     String       @default("active") // active, expiring_soon, expired, none
  contractStartDate  DateTime?
  contractEndDate    DateTime?
  contractFileUrl    String?
  notes              String?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?

  programs           Program[]
  applications       Application[]
  commissions        UniversityCommission[]

  @@index([countryId])
  @@index([nameEn])
}

model Program {
  id              String       @id @default(cuid())
  universityId    String
  university      University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  nameAr          String
  nameEn          String
  level           String       // language, bachelor, master, phd, foundation
  faculty         String?
  durationYears   Float?
  language        String       @default("English")
  tuitionFee      Float
  currency        String       @default("EUR")
  admissionRequirements String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  applications    Application[]

  @@index([universityId])
  @@index([level])
}

model KanbanStage {
  id          String        @id @default(cuid())
  nameAr      String
  nameEn      String
  slug        String        @unique
  order       Int
  color       String        @default("#3b82f6")
  isDefault   Boolean       @default(false)
  isTerminal  Boolean       @default(false)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  applications Application[]

  @@index([order])
  @@index([slug])
}

model Student {
  id                 String       @id @default(cuid())
  studentCode        String       @unique // e.g. AML-2026-001
  fullNameAr         String
  fullNameEn         String
  nationality        String
  birthDate          DateTime?
  gender             String?      // male, female
  phone              String
  whatsapp           String
  email              String
  city               String?
  residenceCountry   String
  passportNumberEnc  String       // Encrypted passport number
  passportExpiry     DateTime?

  // Academic background
  lastCertificate    String?      // High School, Bachelor, Master
  gpa                String?
  previousMajor      String?
  languageLevel      String?
  ieltsToeflScore    String?

  // Study interests
  desiredMajor       String?
  desiredCountry     String?
  budget             Float?
  budgetCurrency     String       @default("USD")
  intake             String?      // Fall 2026, Spring 2027
  targetLevel        String?      // language, bachelor, master, phd, foundation

  // Internal CRM
  branchId           String?
  branch             Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  counselorId        String?
  counselor          User?        @relation("StudentCounselor", fields: [counselorId], references: [id])
  leadSourceId       String?
  leadSource         LeadSource?  @relation(fields: [leadSourceId], references: [id])
  registrationDate   DateTime     @default(now())
  status             String       @default("new") // new, active, accepted, visa_stage, travelled, cancelled
  notes              String?
  avatarUrl          String?
  customFieldsData   String?      // JSON string for dynamic custom fields values

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?

  applications       Application[]
  documents          StudentDocument[]
  visaCases          VisaCase[]
  payments           Payment[]
  tasks              Task[]
  communications     Communication[]
  travelRecords      TravelRecord[]
  timelineEvents     TimelineEvent[]
  contracts          Contract[]
  invoices           Invoice[]

  @@index([phone])
  @@index([email])
  @@index([studentCode])
  @@index([branchId])
  @@index([counselorId])
  @@index([status])
}

model Application {
  id                 String       @id @default(cuid())
  applicationCode    String       @unique // e.g. APP-2026-001
  studentId          String
  student            Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  countryId          String
  country            Country      @relation(fields: [countryId], references: [id])
  universityId       String
  university         University   @relation(fields: [universityId], references: [id])
  programId          String?
  program            Program?     @relation(fields: [programId], references: [id])
  customMajor        String?
  level              String       // language, bachelor, master, phd, foundation
  intake             String       // Fall 2026, Spring 2027
  stageId            String
  stage              KanbanStage  @relation(fields: [stageId], references: [id])
  status             String       @default("submitted") 
  applicationDate    DateTime     @default(now())
  deadline           DateTime?
  offerType          String?      // conditional, final, none
  offerExpiry        DateTime?
  tuitionFee         Float?
  tuitionCurrency    String       @default("EUR")
  applicationFee     Float?       @default(0)
  responsibleUserId  String?
  responsibleUser    User?        @relation("ApplicationOfficer", fields: [responsibleUserId], references: [id])
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?

  visaCases          VisaCase[]
  commissions        UniversityCommission[]
  tasks              Task[]

  @@index([studentId])
  @@index([countryId])
  @@index([universityId])
  @@index([stageId])
  @@index([responsibleUserId])
}

model DocumentType {
  id          String   @id @default(cuid())
  nameAr      String
  nameEn      String
  code        String   @unique
  category    String   // personal, academic, language, visa, other
  isRequired  Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  studentDocuments StudentDocument[]
  countryTemplates CountryChecklistTemplate[]
}

model CountryChecklistTemplate {
  id             String       @id @default(cuid())
  countryId      String
  country        Country      @relation(fields: [countryId], references: [id], onDelete: Cascade)
  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  category       String       // visa, admission
  isMandatory    Boolean      @default(true)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  @@index([countryId])
  @@index([documentTypeId])
}

model StudentDocument {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  title          String
  fileUrl        String
  fileName       String
  fileSize       Int
  fileMimeType   String
  status         String       @default("waiting_for_student") // complete, waiting_for_student, in_translation, needs_correction, rejected, verified
  expiryDate     DateTime?
  rejectionReason String?
  verifiedAt     DateTime?
  verifiedBy     String?
  version        Int          @default(1)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  @@index([studentId])
  @@index([documentTypeId])
  @@index([status])
}

model VisaCase {
  id                   String       @id @default(cuid())
  caseNumber           String       @unique
  studentId            String
  student              Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  countryId            String
  country              Country      @relation(fields: [countryId], references: [id])
  applicationId        String?
  application          Application? @relation(fields: [applicationId], references: [id])
  responsibleOfficerId String?
  responsibleOfficer   User?        @relation("VisaOfficer", fields: [responsibleOfficerId], references: [id])
  status               String       @default("preparing_documents") // preparing_documents, appointment_booked, awaiting_decision, approved, rejected
  embassyLocation      String?      // e.g. BLS Madrid Cairo, VFS Global
  appointmentDate      DateTime?
  submissionDate       DateTime?
  decisionDate         DateTime?
  travelDate           DateTime?
  studyStartDate       DateTime?
  result               String?      // approved, rejected, pending
  rejectionReason      String?
  visaNumber           String?
  visaValidFrom        DateTime?
  visaValidUntil       DateTime?
  notes                String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  createdBy            String?
  updatedBy            String?
  deletedAt            DateTime?

  checklistItems       VisaChecklistItem[]

  @@index([studentId])
  @@index([countryId])
  @@index([status])
  @@index([responsibleOfficerId])
}

model VisaChecklistItem {
  id          String    @id @default(cuid())
  visaCaseId  String
  visaCase    VisaCase  @relation(fields: [visaCaseId], references: [id], onDelete: Cascade)
  nameAr      String
  nameEn      String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  @@index([visaCaseId])
}

model Contract {
  id              String       @id @default(cuid())
  contractNumber  String       @unique
  studentId       String
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalAmount     Float
  currency        String       @default("USD")
  paidAmount      Float        @default(0)
  remainingAmount Float
  startDate       DateTime     @default(now())
  terms           String?
  status          String       @default("active") // active, completed, cancelled
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  invoices        Invoice[]
  payments        Payment[]

  @@index([studentId])
}

model Invoice {
  id             String    @id @default(cuid())
  invoiceNumber  String    @unique
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contractId     String?
  contract       Contract? @relation(fields: [contractId], references: [id])
  amount         Float
  currency       String    @default("USD")
  dueDate        DateTime
  status         String    @default("unpaid") // unpaid, partial, paid, overdue
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  payments       Payment[]

  @@index([studentId])
  @@index([status])
}

model Payment {
  id             String    @id @default(cuid())
  receiptNumber  String    @unique // e.g. REC-2026-001
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contractId     String?
  contract       Contract? @relation(fields: [contractId], references: [id])
  invoiceId      String?
  invoice        Invoice?  @relation(fields: [invoiceId], references: [id])
  amount         Float     // amount in paid currency
  currency       String    // USD, EUR, TRY, etc.
  exchangeRate   Float     @default(1.0) // rate to base currency (USD)
  baseAmount     Float     // amount in base currency (USD)
  paymentDate    DateTime  @default(now())
  method         String    // cash, bank_transfer, card, western_union, online
  receiverId     String?
  receiver       User?     @relation("PaymentReceiver", fields: [receiverId], references: [id])
  notes          String?
  receiptFileUrl String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  @@index([studentId])
  @@index([paymentDate])
  @@index([receiverId])
}

model Currency {
  id           String    @id @default(cuid())
  code         String    @unique // USD, EUR, GBP, TRY, RUB, HUF, IQD
  nameAr       String
  nameEn       String
  symbol       String
  isBase       Boolean   @default(false)
  rateToBase   Float     @default(1.0) // 1 Unit = X USD
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  ratesFrom    ExchangeRate[] @relation("FromCurrency")
  ratesTo      ExchangeRate[] @relation("ToCurrency")

  @@index([code])
}

model ExchangeRate {
  id             String    @id @default(cuid())
  fromCurrencyId String
  fromCurrency   Currency  @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrencyId   String
  toCurrency     Currency  @relation("ToCurrency", fields: [toCurrencyId], references: [id])
  rate           Float
  effectiveDate  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  @@index([fromCurrencyId])
  @@index([toCurrencyId])
}

model UniversityCommission {
  id              String       @id @default(cuid())
  referenceNumber String       @unique
  applicationId   String
  application     Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  universityId    String
  university      University   @relation(fields: [universityId], references: [id])
  tuitionPaid     Float
  tuitionCurrency String       @default("EUR")
  commissionRate  Float        // percentage or fixed
  commissionAmount Float       // expected amount in commission currency
  currency        String       @default("EUR")
  status          String       @default("expected") // expected, invoiced, partially_received, received
  invoicedDate    DateTime?
  receivedDate    DateTime?
  amountReceived  Float        @default(0)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  @@index([applicationId])
  @@index([universityId])
  @@index([status])
}

model Task {
  id            String       @id @default(cuid())
  title         String
  description   String?
  priority      String       @default("medium") // low, medium, high, urgent
  status        String       @default("pending") // pending, in_progress, completed, cancelled
  dueDate       DateTime?
  assigneeId    String?
  assignee      User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId     String?
  creator       User?        @relation("TaskCreator", fields: [creatorId], references: [id])
  studentId     String?
  student       Student?     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?

  @@index([assigneeId])
  @@index([studentId])
  @@index([status])
  @@index([dueDate])
}

model Communication {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation("UserCommunications", fields: [userId], references: [id])
  type        String    // whatsapp, call, email, visit, note
  direction   String    @default("outbound") // inbound, outbound
  subject     String?
  content     String
  sentAt      DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  @@index([studentId])
  @@index([type])
}

model TravelRecord {
  id               String    @id @default(cuid())
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  flightNumber     String?
  departureAirport String?
  arrivalAirport   String?
  departureDate    DateTime?
  arrivalDate      DateTime?
  transitCities    String?
  hasAirportPickup Boolean   @default(false)
  pickupPerson     String?
  pickupPhone      String?
  accommodationAddress String?
  status           String    @default("scheduled") // scheduled, departed, arrived
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?

  @@index([studentId])
}

model TimelineEvent {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category    String    // status_change, document, payment, application, visa, travel, communication, note
  titleAr     String
  titleEn     String
  description String?
  color       String    @default("blue") // green (done), yellow (pending), blue (scheduled), red (problem)
  iconName    String?
  metadata    String?   // JSON string of event payload
  actorName   String    @default("System")
  actorId     String?
  eventDate   DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  @@index([studentId])
  @@index([eventDate])
  @@index([category])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleAr     String
  titleEn     String
  messageAr   String
  messageEn   String
  type        String    // missing_doc, embassy_soon, passport_expiry, offer_expiry, deadline_soon, inactive_student, contract_expiry, installment_due
  linkUrl     String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  @@index([userId])
  @@index([isRead])
  @@index([type])
}

model MessageTemplate {
  id          String    @id @default(cuid())
  code        String    @unique
  nameAr      String
  nameEn      String
  channel     String    @default("whatsapp") // whatsapp, email, sms
  contentAr   String
  contentEn   String
  variables   String    // Comma-separated: {student_name}, {university}, {date}, etc.
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  @@index([code])
}

model LeadSource {
  id          String    @id @default(cuid())
  nameAr      String
  nameEn      String
  code        String    @unique
  color       String    @default("#6b7280")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  students    Student[]

  @@index([code])
}

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation("UserAuditLogs", fields: [userId], references: [id])
  userName   String?
  action     String    // create, update, delete, status_change, export, login
  entity     String    // Student, Application, Payment, VisaCase, etc.
  entityId   String?
  details    String?
  oldValue   String?   // JSON
  newValue   String?   // JSON
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedAt  DateTime?

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model LookupOption {
  id          String    @id @default(cuid())
  category    String    // study_level, student_status, application_status, payment_method, document_status, task_priority
  key         String
  labelAr     String
  labelEn     String
  color       String?   @default("#6366f1")
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([category, key])
  @@index([category])
}

model CustomField {
  id          String    @id @default(cuid())
  entity      String    // Student, Application, University
  name        String
  labelAr     String
  labelEn     String
  type        String    // text, number, date, select, checkbox
  optionsJson String?   // JSON array of options
  isRequired  Boolean   @default(false)
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([entity])
}

